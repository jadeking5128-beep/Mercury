# Generate with: mercury token
MERCURY_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
MERCURY_DB=/var/lib/mercury/mercury.db
MERCURY_HOST=127.0.0.1
MERCURY_PORT=8765

# Exact origin of the deployed Vercel dashboard
MERCURY_CORS_ORIGINS=https://your-project.vercel.app

# Optional OpenAI-compatible AI provider
MERCURY_AI_BASE_URL=
MERCURY_AI_API_KEY=
MERCURY_AI_MODEL=

# Termux worker settings (set on the worker device)
MERCURY_API_URL=https://your-api-host
